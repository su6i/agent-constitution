{
  "hooks": {
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/save-handoff.sh",
            "timeout": 15,
            "statusMessage": "💾 session backup"
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/save-summary.sh",
            "timeout": 15,
            "statusMessage": "📝 summary → SESSION.md"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-resume.sh",
            "timeout": 10,
            "statusMessage": "▶️ session continuity"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-snapshot.sh",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/save-handoff.sh",
            "timeout": 15,
            "statusMessage": "💾 session backup"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-narrative-end.sh",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-session-saved.sh",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context-checkpoint.py",
            "timeout": 15,
            "statusMessage": "💾 checkpoint (50k steps + pre-commit)"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/workdir-guard.sh",
            "timeout": 10,
            "statusMessage": "⛔ working-dir guard"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/block-ai-attribution.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-session-saved.sh",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 ~/.claude/hooks/context-warn.py",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-session-save.sh"
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/check-session-saved.sh",
            "timeout": 10,
            "statusMessage": "💾 session-save gate"
          }
        ]
      }
    ]
  },
  "autoCompactWindow": 200000
}
